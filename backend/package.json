  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "globals": "^17.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^6.3.4"
  }

{
  "name": "tagt-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/jobs/worker.js",
    "dev": "nodemon src/server.js",
    "dev:worker": "nodemon src/jobs/worker.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:worker\"",
    "test": "jest",
    "lint": "eslint src/**/*.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@sentry/node": "^10.42.0",
    "@sentry/profiling-node": "^10.42.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.70.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.3",
    "express-rate-limit": "^7.0.0",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^10.6.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.10.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.1.0",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.8",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "winston-loki": "^6.1.4"
